      <rdf:Description rdf:about=""
            xmlns:xmp="http://ns.adobe.com/xap/1.0/">
         <xmp:CreateDate>2026-07-01T18:54:02+05:30</xmp:CreateDate>
         <xmp:ModifyDate>2026-07-01T19:50:58+05:30</xmp:ModifyDate>
