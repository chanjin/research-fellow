digraph ResearchFellowAPF {
  graph [
    rankdir=TB,
    splines=spline,
    overlap=false,
    compound=true,
    newrank=true,
    bgcolor="white",
    fontname="나눔명조",
    label="현재 구현으로부터 역공학한 전문 연구위원 에이전트 APF",
    labelloc="b",
    fontsize=12,
    dpi=300

  ];

  node [
    shape=box,
    style="filled",
    fillcolor="white",
    color="#222222",
    //penwidth=1.4,
    fontname="나눔명조",
    fontsize=11,
    margin="0.5,0.10"
  ];

  edge [
    color="#111111",
    //penwidth=1.4,
    arrowsize=0.75,
    fontname="나눔명조",
    fontsize=9
  ];

  requirement [
    shape=ellipse,
    style="filled,dashed",
    fillcolor="#FFF400",
    penwidth=1.5,
    label="R: 근거 기반 연구 동반자 직무의 지속적 수행\n(살아있는 도메인 지식 + 비판적 공동 집필)"
  ];



    literature [
      shape=note,
      label="<<Causal>>\n학술 문헌 및 원문 사이트[W_문헌]\n- 논문 / PDF / 웹페이지\n- 메타데이터 / 인용 / 초록"
    ];

    m1 [
      shape=box,
      peripheries=2,
      fillcolor="#F8F8F8",
      penwidth=2.0,
      label="<<Machine: Curator>>\nM1 지식 큐레이터 [M1]\n- 문헌 탐색 및 논문 읽기\n- 지식카드 및 온톨로지 진화"
    ];

    memory [
      shape=note,
      fillcolor="#D9D9D9",
      label="<<Lexical: 운영 맥락>>\n연구 자산 및 메모리 [S_t, K_t]\n- 탐색 의도 / 탐색 실행 / 서재함 및 원문\n- 지식카드 / 관계 / 버전 온톨로지\n- 연구질문 / 논문 프로젝트 / 원고\n- 의사결정 / 할 일 / 참고문헌 / 리비전 이력"
    ];

    llm [
      shape=box,
      fillcolor="#FFFFFF",
      label="<<Causal>>\n내부·외부 LLM 서비스 [W_LLM]\n- 프롬프트 조건부 생성\n- 비결정적 초안 / JSON 응답"
    ];

    m2 [
      shape=box,
      peripheries=2,
      fillcolor="#D9D9D9",
      penwidth=2.0,
      label="<<Machine: Co-author / Advisor>>\nM2 연구 공동 저자 [M2]\n- 연구질문 및 논문 프로젝트 구성\n- 근거 검토 / 할 일 / 원고 리비전\n- 자문 요청 해석 및 답변"
    ];

    researcher [
      shape=box,
      style="filled,dashed",
      fillcolor="#FFF400",
      label="<<Biddable>>\n인간 연구자 [W_연구자]\n- 최종 판단 권한\n- 검토 / 수정 / 승인"
    ];

    requester [
      shape=box,
      style="filled,dashed",
      fillcolor="#FFF8A6",
      label="<<Biddable>>\n외부 자문 요청자 [W_요청자]\n- 질문 / 요청 맥락\n- 범위 확인 / 후속 질문"
    ];

    workspace_server [
      shape=folder,
      fillcolor="#FFFFFF",
      label="<<Lexical>>\n워크스페이스 저장소 [W_서버]\n- 워크스페이스 DB 스냅샷\n- 버전이 부여된 논문 원문"
    ];

    //{ rank=same; m1; memory; llm; }
    //{ rank=same; researcher; m2; requester; }

    literature -> m1 [
      dir=both,
      label="1. 논문 메타데이터 및 원문\n2. 탐색 의도 및 원문 확보 요청"
    ];

    m1 -> llm [
      dir=both,
      style=dashed,
      label="3. 탐색 / 읽기 / 온톨로지 프롬프트\n초안 또는 구조화 응답"
    ];

    m1 -> memory [
      dir=both,
      label="4. 서재함, 출처, 탐색 이력,\n지식카드 및 온톨로지 버전"
    ];

    m1 -> m2 [
      style=dotted,
      penwidth=2.0,
      label="5. 지식 업데이트 (knowledge_update)\n새 근거 / 공백 / 상충"
    ];

    m2 -> m1 [
      style=dotted,
      penwidth=2.0,
      constraint=false,
      label="6. 승인된 탐색 의도 (curation_intent)\n필요 근거 및 완료 조건"
    ];

    researcher -> m1 [
      dir=both,
      label="7. 원문, 지식카드 및 온톨로지 검토\n승인 / 수정 / 보류 / 반려"
    ];

    researcher -> m2 [
      dir=both,
      label="8. 연구질문, 저자 입력 및 피드백    \n제안 / 원고 / 의사결정 / 반영 확인    "
    ];

    m2 -> memory [
      dir=both,
      label="9. 근거 맥락 및 프로젝트 상태\n원고 / 할 일 / 참고문헌 / 변경 이력"
    ];

    m2 -> llm [
      dir=both,
      style=dashed,
      label="10. 연구 제안, 초안 작성, 리비전\n및 해결 여부 검증 타스크"
    ];

    m2 -> requester [
      dir=both,
      label="11. 자문 요청 / 해석된 답변 범위\n근거 기반 답변 / 후속 질문"
    ];

    memory -> workspace_server [
      dir=both,
      style=dashed,
      label="12. 전체 워크스페이스 DB 통합\n및 논문 원문 동기화"
    ];

  requirement -> m1 [style=dotted, arrowhead=none, color="#607D8B", constraint=false];
  requirement -> m2 [style=dotted, arrowhead=none, color="#607D8B", constraint=false];
  requirement -> researcher [style=dotted, arrowhead=none, color="#607D8B", constraint=false];
  //requirement -> literature [style=invis, weight=12];
}
