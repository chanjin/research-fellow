- {{ card.title }}
  Claim: {{ card.claim }}
  Explanation: {{ card.explanation }}
  Labels: {{ card.labels | join(', ') }}
  Concepts: {{ card.concepts | join(', ') }}
  Applies to: {{ card.applies_to | join(', ') }}
